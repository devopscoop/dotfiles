#!/usr/bin/env bash
# Daily, non-destructive refresh of every git repo under ~/git, at any depth.
# Never switches branches, never creates merge commits, never touches uncommitted work.
# Adds any forge remote that a repo of one of the owners below is missing.
# Syncs the default branch across all remotes: fast-forwards to each, pushes to each.
# Then flags repos the owners below have on GitHub, GitLab, or Codeberg but that
# aren't cloned under ~/git.
# Runs on Linux and macOS. Only use flags GNU and BSD find/awk/paste share: on
# macOS, launchd gets the BSD tools and interactive shells get Homebrew's GNU ones.
set -o pipefail
# launchd's PATH lacks Homebrew (git, git-remote-rad, gh).
[[ "$OSTYPE" == darwin* ]] && export PATH="/opt/homebrew/bin:$PATH"

# Accounts whose every unarchived repo should be cloned, on all three forges.
# Keep in step with the first family in check_remotes.
owners=(3uzbcqje devopscoop 6j0-org)

g() { git -C "$repo" "$@"; }
# One logfmt line: log LEVEL MSG [KEY=VALUE...], stamped with RFC 3339 UTC time.
# Values that are empty or hold spaces, quotes, = or \ get quoted and escaped.
# launchd runs macOS's bash 3.2, hence date(1) rather than printf's %(...)T.
log() {
  local line="ts=$(date -u +%Y-%m-%dT%H:%M:%SZ) level=$1" kv v
  shift
  for kv in "msg=$1" "${@:2}"; do
    v=${kv#*=}
    case $v in '' | *[[:space:]\"=\\]*)
      v=${v//\\/\\\\}; v=${v//\"/\\\"}; v=\"${v//$'\n'/\\n}\" ;;
    esac
    line+=" ${kv%%=*}=$v"
  done
  printf '%s\n' "$line"
}
# Anything a human needs to look at: log it, and count it for the notification.
attention=0
warn() { log warn "$@"; attention=$((attention + 1)); }

# Every repo in a known family must have exactly its expected $remotes, each
# fetching and pushing to the expected host. Repos in no family aren't checked.
# Warns and returns 1 on any mismatch.
check_remotes() {
  local want r url pat ok=0
  case $name in
    3uzbcqje-* | 6j0-org-* | devopscoop-*) want='codeberg github gitlab rad' ;;
    Equal-Vote/* | EdgeApp/* | aur.archlinux.org/*) want=origin ;;
    *) return 0 ;;
  esac
  [ "$remotes" = "$want" ] \
    || { warn "unexpected remotes" repo="$name" want="$want" got="$remotes"; return 1; }
  # `remote -v` lists each remote's fetch and push URL; sort -u folds the two
  # when they're the same. An unquoted $pat in a case pattern is matched as a glob.
  while read -r r url; do
    case $name/$r in
      aur.archlinux.org/*/origin) pat='ssh://aur@aur.archlinux.org/*' ;;
      */origin | */github) pat='*github.com[:/]*' ;;
      */gitlab) pat='*gitlab.com[:/]*' ;;
      */codeberg) pat='*codeberg.org[:/]*' ;;
      */rad) pat='rad://*' ;;
      *) continue ;; # a rad peer, already left out of $remotes
    esac
    case $url in
      $pat) ;;
      *) warn "unexpected remote url" repo="$name" remote="$r" url="$url" want="$pat"; ok=1 ;;
    esac
  done < <(g remote -v | awk '{ print $1, $2 }' | sort -u)
  return $ok
}

# Give a repo at ~/git/OWNER-NAME, for an OWNER in $owners, each forge remote it
# lacks, pointing at OWNER/NAME on that forge. rad can't be added this way: its
# URL holds a repo ID, not a name.
add_remotes() {
  local owner path= forge r
  for owner in "${owners[@]}"; do
    case $name in */*) ;; "$owner"-*) path=$owner/${name#"$owner"-} ;; esac
  done
  [ -n "$path" ] || return 0
  for forge in codeberg.org github.com gitlab.com; do
    r=${forge%.*}
    g remote get-url "$r" >/dev/null 2>&1 && continue
    # A plain `git clone` names its remote origin: rename it, don't duplicate it.
    case $(g remote get-url origin 2>/dev/null) in
      *"$forge"[:/]*)
        g remote rename origin "$r" && log info "renamed remote" repo="$name" from=origin to="$r"
        continue ;;
    esac
    g remote add "$r" "git@$forge:$path.git" \
      && log info "added remote" repo="$name" remote="$r" url="git@$forge:$path.git"
  done
}

# Run jq filter $2 over every page of the paged JSON array API at $1. Output is
# held back until the last page arrives, so a failure prints only curl's error.
paged() {
  local page=1 body all=
  while body=$(curl -fsS -m 30 "$1&page=$page"); do
    [ "$body" = "[]" ] && { printf '%s' "$all"; return; }
    all+=$(jq -r "$2" <<<"$body")$'\n' || return
    page=$((page + 1))
  done
  return 1
}
# Print host/owner/name for each unarchived repo owner $2 has on forge $1.
# GitLab and Codeberg are asked without a token, so they list public repos only.
list_repos() {
  local f
  case $1 in
    github.com)
      # Not --no-archived: it switches to the search API, which lags behind new
      # repos and returns nothing, successfully, for an owner that doesn't exist.
      gh repo list "$2" --limit 1000 --json nameWithOwner,isArchived \
        --jq '.[] | select(.isArchived | not) | "github.com/" + .nameWithOwner' ;;
    gitlab.com)
      # Users and groups have separate endpoints. A project pending deletion is
      # renamed to NAME-deletion_scheduled-ID and still listed.
      f='.[] | select(.path | test("-deletion_scheduled-[0-9]+$") | not) | "gitlab.com/" + .path_with_namespace'
      paged "https://gitlab.com/api/v4/users/$2/projects?archived=false&per_page=100" "$f" 2>/dev/null \
        || paged "https://gitlab.com/api/v4/groups/$2/projects?archived=false&include_subgroups=true&per_page=100" "$f" ;;
    codeberg.org)
      paged "https://codeberg.org/api/v1/users/$2/repos?limit=50" \
        '.[] | select(.archived | not) | "codeberg.org/" + .full_name' ;;
  esac
}

[ $# -eq 0 ] || { echo "usage: ${0##*/}" >&2; exit 2; }

log info "sync started"
cloned=
# One .git path per pass, from the find after `done`. IFS= keeps leading/trailing
# spaces, -r keeps backslashes, -d '' splits on NUL (find's -print0). -u 3 reads
# the list from fd 3, not stdin: anything in the loop that reads stdin (ssh, gh,
# a prompt) would otherwise eat the remaining paths and silently end the loop.
while IFS= read -r -d '' -u 3 dotgit; do
  repo=${dotgit%/.git}; name=${repo#"$HOME/git"/}
  # Let git decide. Only a standalone clone reports ".git" here; submodules and
  # linked worktrees report a path elsewhere, and non-repos fail.
  [ "$(g rev-parse --git-dir 2>/dev/null)" = .git ] || continue
  # Its path and remote URLs, for matching against forge repos after the loop.
  cloned+=$name$'\n'$(g config --get-regexp '^remote\..*\.url$')$'\n'

  add_remotes
  # rad adds a remote named NID or ALIAS@NID for every peer it tracks. They're
  # other nodes' namespaces, which we can't push to, so neither check nor sync them.
  remotes=$(g remote | grep -Ev '^([^@]*@)?z6Mk' | LC_ALL=C sort | paste -sd' ' -)
  # We push to every remote, so never sync a repo whose remotes look wrong.
  check_remotes || continue

  # Capture git's complaint so it lands in the log line, not as loose text.
  err=$(g fetch --all --prune --quiet 2>&1) \
    || { warn "fetch failed" repo="$name" error="$err"; continue; }

  default=$(g symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
  default=${default#origin/}; default=${default:-main}
  local_ref=refs/heads/$default
  current=$(g branch --show-current)
  before=$attention

  # Collect every remote's copy of the default branch: fast-forward to each in turn.
  # Git refuses if diverged or if it would overwrite local edits.
  found=0 changed=0
  for r in $remotes; do
    ref=refs/remotes/$r/$default
    g rev-parse --verify --quiet "$ref" >/dev/null || continue
    found=1
    g merge-base --is-ancestor "$ref" "$local_ref" 2>/dev/null && continue # already have it
    if [ "$current" = "$default" ]; then
      g merge --ff-only --quiet "$ref" >/dev/null 2>&1
    else
      g fetch --quiet . "$ref:$local_ref" 2>/dev/null
    fi && changed=1 \
      || warn "couldn't fast-forward" repo="$name" branch="$default" remote="$r"
  done
  [ "$found" = 1 ] || { warn "no remote has branch" repo="$name" branch="$default"; continue; }

  # Push the result to every remote that's behind. A plain push is fast-forward
  # only, so a diverged remote (already warned above) is skipped, never overwritten.
  for r in $remotes; do
    ref=refs/remotes/$r/$default
    g rev-parse --verify --quiet "$ref" >/dev/null || continue
    [ "$(g rev-parse "$ref")" = "$(g rev-parse "$local_ref")" ] && continue
    g merge-base --is-ancestor "$ref" "$local_ref" || continue
    err=$(g push --quiet "$r" "$local_ref:$local_ref" 2>&1) \
      && { changed=1; log info "pushed" repo="$name" branch="$default" remote="$r"; } \
      || warn "push failed" repo="$name" branch="$default" remote="$r" error="$err"
  done
  # Summarize only clean repos; a repo with warnings already has its own lines.
  if [ "$attention" = "$before" ]; then
    if [ "$changed" = 1 ]; then
      log info "repo synced" repo="$name" branch="$default"
    else
      log info "no changes" repo="$name" branch="$default"
    fi
  fi

  # Uncommitted work can block the fast-forward, so flag it.
  [ -n "$(g status --porcelain)" ] && warn "uncommitted changes" repo="$name"
# find: don't descend into .terraform or node_modules (dependency clones, not
# repos we own); print each .git, NUL-terminated, without walking inside it.
# sort -z orders them alphabetically, still NUL-terminated; LC_ALL=C so launchd
# and interactive shells agree. 3< feeds that list to the read's -u 3.
done 3< <(find "$HOME/git" \( -name .terraform -o -name node_modules \) -prune -o -name .git -prune -print0 \
  | LC_ALL=C sort -z)

forge_repos=
for forge in github.com gitlab.com codeberg.org; do
  for owner in "${owners[@]}"; do
    if out=$(list_repos "$forge" "$owner" 2>&1); then
      forge_repos+=$out$'\n'
    else
      warn "couldn't list repos" forge="$forge" owner="$owner" error="$out"
    fi
  done
done
# A forge repo owner/name counts as cloned if any clone has a remote pointing
# at owner/name on any host, or sits at ~/git/owner-name (the layout
# check_remotes expects) or ~/git/owner/name. Matching ignores the host, so one
# clone covers a repo's mirrors on the other forges, and a repo missing from
# several forges is reported once.
while read -r missing forges; do
  warn "not cloned" repo="$missing" forges="$forges"
done < <(awk '
  !NF { next }
  FILENAME == ARGV[1] {
    if (/^remote\.[^ ]*\.url /) {
      # Keep only the path: drop scheme://host/ or scp-style [user@]host:, then .git.
      $0 = $2
      if (!sub(/^[a-z][a-z0-9+.-]*:\/\/[^\/]*\//, "")) sub(/^[^:]*:/, "")
      sub(/\.git\/?$/, "")
    }
    have[tolower($0)]
    next
  }
  {
    host = $0; sub(/\/.*/, "", host); path = substr($0, length(host) + 2)
    k = tolower(path); flat = k; gsub(/\//, "-", flat)
    if ((k in have) || (flat in have)) next
    if (k in on) on[k] = on[k] "," host
    else { on[k] = host; repos[++n] = path }
  }
  END { for (i = 1; i <= n; i++) print repos[i], on[tolower(repos[i])] }
' <(printf '%s' "$cloned") <(printf '%s' "$forge_repos"))

log info "sync finished" attention="$attention"
if [ "$attention" -gt 0 ]; then
  if [[ "$OSTYPE" == darwin* ]]; then
    osascript -e "display notification \"$attention item(s) need attention. See ~/Library/Logs/git-sync.log\" with title \"git sync\""
  elif command -v notify-send >/dev/null; then
    notify-send "git sync" "$attention item(s) need attention. See journalctl --user -u git-sync"
  fi
fi
