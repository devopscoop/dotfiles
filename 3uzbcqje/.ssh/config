# macOS's ssh-agent starts empty on every boot, and without these options ssh
# never consults the login keychain for key passphrases — so every git/ssh
# command prompts for the id_ed25519 passphrase after a reboot.
#
# UseKeychain:    read the passphrase from the macOS keychain (and store it
#                 there the first time it's entered)
# AddKeysToAgent: load the key into the running ssh-agent on first use, so
#                 subsequent commands in the same boot don't touch the keychain
Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
